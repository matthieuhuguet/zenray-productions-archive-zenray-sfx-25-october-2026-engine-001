# 26 October 2026 00:55: every slider of every component, two proofs. CONTINUITY: a step twenty times smaller than
# SMALL moves the sound by less than 0.5 dB locally (no hidden jump between the identity path and the edit path). EFFECT: a
# moderate move is audible (>= 1 dB locally), stays finite and does not explode in level. FR : continuité et effet
# de chaque curseur.
import sys, json, glob; sys.path.insert(0, ".")
import numpy as np
from zrsfx import semantic as SM
SMALL = {"levelDb": 0.1, "pitchSt": 0.005, "attack": 1.002, "tail": 1.002, "bright": 0.05, "material": 0.002, "shiftMs": 0.1}
MOVE = {"levelDb": -6, "pitchSt": 3, "attack": 2.0, "tail": 2.0, "bright": 3, "material": 0.7, "shiftMs": 40}
if "--red" in sys.argv:  # deliberately broken: a 3 dB jump as soon as a partial leaves the identity path
    _orig = SM._edited_track
    SM._edited_track = lambda *a, **k: 1.41 * _orig(*a, **k)
fails = 0
for f in sorted(glob.glob(sys.argv[1])):
    r = json.load(open(f)); m = SM.build(r)
    base = SM.render(m, {}, 7); peak0 = np.abs(base).max()
    for c in m["components"]:
        if c["desc"]["share"] < 0.02:
            continue
        row = []
        for k in SMALL:
            # Continuity in the mathematical sense: the change must vanish with the step. A real jump would survive
            # any step; a beating between neighbouring partials shrinks with it (26 October 2026).
            d0 = 1.0 if k in ("attack", "tail") else 0.0
            tiny_v = d0 + (SMALL[k] - d0) / 20
            small = SM.edit_distance(m, {str(c["index"]): {k: tiny_v}})["peakDb"]
            if small >= 0.5:  # a limit, not a single point: ten times smaller must have shrunk at least threefold
                smaller = SM.edit_distance(m, {str(c["index"]): {k: d0 + (SMALL[k] - d0) / 200}})["peakDb"]
                if smaller < 0.5 and smaller <= small / 3:
                    small = smaller
            y = SM.render(m, {str(c["index"]): {k: MOVE[k]}}, 7)
            move = SM.edit_distance(m, {str(c["index"]): {k: MOVE[k]}})["peakDb"]
            bad = small >= 0.5 or move < 1 or not np.isfinite(y).all() or np.abs(y).max() > 8 * peak0
            fails += bad
            row.append(f"{k}:{small:.2f}/{move:.1f}{' FAIL' if bad else ''}")
        print(r["name"][:14].ljust(14), c["name"][:26].ljust(26), " ".join(row), flush=True)
print("failures", fails); sys.exit(1 if fails else 0)
