# 25 October 2026 15:35: the external judge. Reuses the perceptual loss of ZenRay Motion Design (zrmd.audio.ploss),
# measured there in JND units: score = 100 * 0.99 ** E2, so 99 means E <= 1 JND. Two readings:
# "exact" compares STFT cells (a noise never reaches 99 against another noise draw), "invariant" compares expected
# spectra (the seed-invariant variant, the one that judges a noisy sound fairly). Never optimised directly here.
# FR : le juge externe, la perte perceptive de ZenRay Motion Design, lue en deux variantes.
from __future__ import annotations

import copy
import sys
from functools import lru_cache

import numpy as np

ZRMD = "/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayMotionDesign"
if ZRMD not in sys.path:
    sys.path.insert(0, ZRMD)

from zrmd.audio import config as _config  # noqa: E402
from zrmd.audio import ploss as _ploss  # noqa: E402


@lru_cache(maxsize=2)
def _cfg(invariant: bool) -> dict:
    c = copy.deepcopy(_config.load())
    c["ploss"]["stochastic"]["enabled"] = bool(invariant)
    return c


def score(ours: np.ndarray, ref: np.ndarray, sr: int) -> dict:
    n = max(len(ours), len(ref))
    a = np.pad(np.asarray(ours, np.float32), (0, n - len(ours)))
    b = np.pad(np.asarray(ref, np.float32), (0, n - len(ref)))
    out = {}
    for name, inv in (("exact", False), ("invariant", True)):
        r = _ploss.score(a, b, sr, _cfg(inv))
        out[name] = round(r["score"], 2)
        out[name + "E"] = round(r["E"], 3)
        out[name + "Errors"] = r["errors"]
    out.update(lines(a, b, sr))
    out.update(floor(a, b, sr))
    out.update(excess(a, b, sr))
    return out


def _smooth_db(x, sr, n_fft=1024, hop=256):
    from scipy.ndimage import uniform_filter
    from .render import stft
    p = np.abs(stft(np.asarray(x, float), n_fft, hop)) ** 2
    return 10 * np.log10(np.maximum(uniform_filter(p, size=(9, 5), mode="nearest"), 0) + 1e-20)


def excess(ours, ref, sr, over_db=10.0, range_db=60.0):
    """25 October 2026 18:50: share of audible time-frequency cells where we are more than over_db louder than the
    reference (blobs and hiss the perceptual loss ignores below its 60 dB floor). 0 = we never add what is not there."""
    do, dr = _smooth_db(ours, sr), _smooth_db(ref, sr)
    live = do > do.max() - range_db
    return {"excessPct": round(float(100 * np.mean((do - dr > over_db)[live])), 2)}


# 25 October 2026 17:15: two readings the perceptual loss is blind to (seen on the first comparison sheet):
# "lines" judges tonal fine structure (peaks standing above their spectral neighbourhood), "floorDb" judges hiss
# added where the reference is silent. FR : deux lectures auxquelles la perte perceptive est aveugle.
LINES = {"nFft": 4096, "hop": 512, "medianBins": 21, "lineDb": 8.0, "rangeDb": 60.0, "persistFrames": 4, "tolBins": 2}


def _peakiness(x, sr):
    from scipy.ndimage import median_filter
    from .render import stft
    d = 10 * np.log10(np.abs(stft(np.asarray(x, float), LINES["nFft"], LINES["hop"])) ** 2 + 1e-20)
    return d, d - median_filter(d, size=(LINES["medianBins"], 1))


def _line_mask(d, p):
    from scipy.ndimage import minimum_filter
    live = d > d.max() - LINES["rangeDb"]
    # A line is a peak that persists over persistFrames frames; a noise peak does not.
    return live & (minimum_filter(p, size=(1, LINES["persistFrames"])) > LINES["lineDb"])


def lines(ours, ref, sr):
    """F-measure of persistent spectral lines: recall (reference lines we reproduce, within tolBins) and precision
    (our lines that exist in the reference). 100 = same tonal skeleton."""
    from scipy.ndimage import binary_dilation
    lr = _line_mask(*_peakiness(ref, sr))
    lo = _line_mask(*_peakiness(ours, sr))
    k = np.ones((2 * LINES["tolBins"] + 1, 3), bool)
    if lr.sum() < 5:
        v = 100.0 if lo.sum() < 5 else 50.0
        return {"lines": v, "linesW": v, "linesRecall": 1.0, "linesPrecision": 1.0}
    rec = float((lr & binary_dilation(lo, k)).sum() / lr.sum())
    pre = float((lo & binary_dilation(lr, k)).sum() / max(lo.sum(), 1))
    f = 2 * rec * pre / max(rec + pre, 1e-9)
    # Level-weighted reading: each line cell weighs its level above the live range floor (0 to 1), so a loud line
    # counts more than a faint fragment; the ear hears the loud skeleton first. Both readings are reported.
    d_r, d_o = _peakiness(ref, sr)[0], _peakiness(ours, sr)[0]
    wr = np.clip((d_r - (d_r.max() - LINES["rangeDb"])) / LINES["rangeDb"], 0, 1)
    wo = np.clip((d_o - (d_o.max() - LINES["rangeDb"])) / LINES["rangeDb"], 0, 1)
    rw = float((wr * (lr & binary_dilation(lo, k))).sum() / max((wr * lr).sum(), 1e-9))
    pw = float((wo * (lo & binary_dilation(lr, k))).sum() / max((wo * lo).sum(), 1e-9))
    fw = 2 * rw * pw / max(rw + pw, 1e-9)
    return {"lines": round(100 * f, 2), "linesRecall": round(rec, 3), "linesPrecision": round(pre, 3),
            "linesW": round(100 * fw, 2)}


def floor(ours, ref, sr, hop=120, quiet_db=50.0):
    def frames(x):
        n = len(x) // hop
        return 10 * np.log10(np.mean(np.asarray(x[:n * hop], float).reshape(n, hop) ** 2, 1) + 1e-20)
    fr, fo = frames(ref), frames(ours)
    q = fr < fr.max() - quiet_db
    return {"floorDb": round(float(np.median(fo[q] - fr[q])), 2) if q.sum() >= 3 else 0.0}
