# 25 October 2026 18:20: line map, red = reference-only lines, green = ours-only, yellow = both.
# FR : carte des lignes tonales, rouge référence seule, vert nous seuls, jaune les deux.
import sys, json; from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import numpy as np, soundfile as sf
from PIL import Image, ImageDraw
from zrsfx.score import _line_mask, _peakiness
from zrsfx.render import render
run, names, out = sys.argv[1], sys.argv[2].split(","), sys.argv[3]
tiles = []
for n in names:
    x, sr = sf.read(f"refs/{n}.wav"); y = render(json.load(open(f"{run}/{n}{sys.argv[4] if len(sys.argv) > 4 else ''}.recipe.json")), sr, seed=7)
    lr, lo = _line_mask(*_peakiness(x, sr)), _line_mask(*_peakiness(y, sr))
    k = 700  # bins up to ~8 kHz
    img = np.zeros((k, lr.shape[1], 3), np.uint8)
    img[..., 0] = lr[:k] * 255; img[..., 1] = lo[:k] * 255
    tiles.append((n, Image.fromarray(img[::-1]).resize((700, 420), Image.NEAREST)))
sheet = Image.new("RGB", (720 * len(tiles), 450), "white"); d = ImageDraw.Draw(sheet)
for i, (n, t) in enumerate(tiles):
    sheet.paste(t, (720 * i, 24)); d.text((720 * i + 4, 4), n + "  (0 to 8 kHz)", fill="black")
sheet.save(out); print(out)
