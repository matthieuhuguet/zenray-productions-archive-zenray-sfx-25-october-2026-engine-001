import copy
import json
import math
from pathlib import Path

import numpy as np

from .render import band_centres, grid_to_bins, istft, render_partials, stft

PARAMS = Path(__file__).resolve().parents[1] / "params" / "semantic.json"


def cfg() -> dict:
    return json.loads(PARAMS.read_text())


# ------------------------------------------------------------------ decomposition
def _nmf(V, k, iters, seed, smooth):
    rng = np.random.default_rng(seed)
    W = rng.random((V.shape[0], k)) + 0.1
    H = rng.random((k, V.shape[1])) + 0.1
    from scipy.ndimage import uniform_filter1d
    for it in range(iters):
        H *= (W.T @ V) / (W.T @ W @ H + 1e-30)
        if smooth > 1 and it % 10 == 0:  # temporal continuity: a component is an event, not a flicker
            H = uniform_filter1d(H, smooth, axis=1, mode="nearest")
        W *= (V @ H.T) / (W @ H @ H.T + 1e-30)
    return W, H


def _noise_scale(recipe, n, sr):
    """Amplitude scale map (bins x frames) of the noise layer, exactly as render_noise builds it."""
    lay = next(l for l in recipe["layers"] if l["type"] == "noise")
    n_fft, hop = lay.get("nFft", 1024), lay.get("hop", 128)
    frames = 1 + (n + n_fft // 2 + n_fft - n_fft) // hop
    gdb = grid_to_bins(np.asarray(lay["grid"], float), np.asarray(lay["times"], float), lay["lo"], lay["hi"], n_fft, hop, frames, sr)
    return lay, 10 ** (gdb / 20.0) / np.sqrt(np.sum(np.hanning(n_fft) ** 2)) * 10 ** (lay.get("gainDb", 0.0) / 20.0)


def decompose(recipe: dict, sr: int = 48000, k: int | None = None) -> dict:
    """Recipe -> semantic model: K components, each with an amplitude mask on the noise STFT (masks sum to one), a
    list of partial tracks, descriptors and a name. Nothing of the recipe is changed."""
    c = cfg()["decompose"]
    k = k or c["components"]
    n = int(round(recipe["seconds"] * sr))
    lay, S = _noise_scale(recipe, n, sr)
    n_fft, hop = lay.get("nFft", 1024), lay.get("hop", 128)
    part = next((l for l in recipe["layers"] if l["type"] == "partials"), {"tracks": []})
    # Total expected power on the noise STFT grid: noise power + each partial's power (rendered alone).
    P_noise = (S ** 2) * np.sum(np.hanning(n_fft) ** 2)
    track_pow = []
    for tr in part["tracks"]:
        y = render_partials({"tracks": [tr]}, n, sr)
        track_pow.append(np.abs(stft(y, n_fft, hop)) ** 2)
    P = P_noise + (sum(track_pow) if track_pow else 0)
    # Factorise a coarse, perceptual view (log-spaced 64 bands), then lift the activations back to every bin.
    f = np.fft.rfftfreq(n_fft, 1 / sr)
    edges = np.geomspace(c["loHz"], sr / 2, c["bands"] + 1)
    band_of = np.clip(np.searchsorted(edges, f) - 1, 0, c["bands"] - 1)
    B = np.zeros((c["bands"], len(f))); B[band_of, np.arange(len(f))] = 1
    Vb = B @ P
    W, H = _nmf(Vb, k, c["iters"], c["seed"], c["smoothFrames"])
    comp = np.stack([np.outer(W[band_of, i], H[i]) for i in range(k)])  # (k, bins, frames)
    tot = comp.sum(0) + 1e-30
    masks = comp / tot  # amplitude masks, sum exactly 1 everywhere (Wiener-like share)
    # Partials: each track goes to the component that owns most of its energy.
    owner = []
    for tp in track_pow:
        share = [(tp * masks[i]).sum() for i in range(k)]
        owner.append(int(np.argmax(share)))
    comps = []
    for i in range(k):
        e_noise = float((P_noise * masks[i] ** 2).sum())
        e_tone = float(sum(tp.sum() for tp, o in zip(track_pow, owner) if o == i))
        pw = (P_noise * masks[i] ** 2).sum(0) + sum((tp.sum(0) for tp, o in zip(track_pow, owner) if o == i), np.zeros(P.shape[1]))
        spec = (P_noise * masks[i] ** 2).sum(1) + sum((tp.sum(1) for tp, o in zip(track_pow, owner) if o == i), np.zeros(P.shape[0]))
        comps.append({"index": i, "tracks": [j for j, o in enumerate(owner) if o == i],
                      "desc": describe(pw, spec, f, hop / sr, e_tone / max(e_noise + e_tone, 1e-30), e_noise + e_tone)})
    total = sum(cp["desc"]["energy"] for cp in comps)
    for cp in comps:
        cp["desc"]["share"] = round(cp["desc"]["energy"] / max(total, 1e-30), 4)
    comps.sort(key=lambda cp: cp["desc"]["peakS"])
    order = [cp["index"] for cp in comps]
    names = name_components([cp["desc"] for cp in comps])
    for cp, nm in zip(comps, names):
        cp["name"] = nm
    return {"recipe": recipe, "sr": sr, "n": n, "masks": masks[order], "components": comps, "nFft": n_fft, "hop": hop}


def describe(pw, spec, f, hop_s, tonal, energy):
    db = 10 * np.log10(pw + 1e-30); db -= db.max()
    k = int(np.argmax(db))
    on = np.nonzero(db > -20)[0]
    start = on[0] if on.size else k
    after = np.nonzero((np.arange(len(db)) > k) & (db < -30))[0]
    end = after[0] if after.size else len(db) - 1
    centroid = float((spec * f).sum() / max(spec.sum(), 1e-30))
    return {"peakS": round(k * hop_s, 4), "attackMs": round((k - start) * hop_s * 1000, 1), "decayMs": round((end - k) * hop_s * 1000, 1),
            "centroidHz": round(centroid, 1), "tonal": round(float(tonal), 3), "energy": float(energy)}


def name_components(descs):
    """Names from descriptors (rules in params/semantic.json): register + kind, unique, in French for the app."""
    c = cfg()["naming"]
    out = []
    for d in descs:
        reg = next(r["name"] for r in c["registers"] if d["centroidHz"] < r["belowHz"])
        if d["decayMs"] <= c["clickMaxMs"] and d["attackMs"] <= c["clickAttackMs"]:
            kind = c["kinds"]["click"]
        elif d["tonal"] >= c["tonalShare"]:
            kind = c["kinds"]["tone"]
        elif d["attackMs"] >= c["swellAttackMs"]:
            kind = c["kinds"]["swell"]
        elif d["decayMs"] >= c["tailMinMs"]:
            kind = c["kinds"]["tail"]
        else:
            kind = c["kinds"]["hit"]
        out.append(f"{kind} {reg}")
    seen = {}
    final = []
    for nm in out:
        seen[nm] = seen.get(nm, 0) + 1
        final.append(nm if out.count(nm) == 1 else f"{nm} {seen[nm]}")
    return final


# ------------------------------------------------------------------ editing
def defaults() -> dict:
    return {k: v["default"] for k, v in cfg()["sliders"].items()}


def _warp_src(t, tp, shift, attack, tail):
    """Output time -> source time for one component: shifted, attack durations x attack, tail durations x tail."""
    u = t - shift
    return np.where(u < tp, tp - (tp - u) / attack, tp + (u - tp) / tail)


def _warp_fwd(t, tp, shift, attack, tail):
    t = np.asarray(t, float)
    return shift + np.where(t < tp, tp - (tp - t) * attack, tp + (t - tp) * tail)


def render(model: dict, edits: dict | None = None, seed: int | None = None) -> np.ndarray:
    """Sum of the components, each edited by its own sliders. edits = {component index: {slider: value}}."""
    r, sr, n = model["recipe"], model["sr"], model["n"]
    sc = cfg()["sliders"]
    E = {cp["index"]: {**defaults(), **(edits or {}).get(str(cp["index"]), (edits or {}).get(cp["index"], {}))} for cp in model["components"]}
    # Output length grows with timing and tail moves.
    extra = 0.0
    for cp in model["components"]:
        e = E[cp["index"]]; tp = cp["desc"]["peakS"]
        extra = max(extra, (r["seconds"] - tp) * (e["tail"] - 1) + e["shiftMs"] / 1000)
    n_out = n + max(0, int(round(extra * sr)))
    s = r.get("seed", 0) if seed is None else seed
    lay, S = _noise_scale(r, n, sr)
    li = r["layers"].index(lay)
    n_fft, hop = model["nFft"], model["hop"]
    X = stft(np.random.default_rng(s * 1009 + li).standard_normal(n_out), n_fft, hop)
    f = np.fft.rfftfreq(n_fft, 1 / sr)
    lf = np.log2(np.maximum(f, 1.0))
    frames_src = S.shape[1]
    t_frames = np.arange(X.shape[1]) * hop / sr
    t_samp = np.arange(n_out) / sr
    part = next((l for l in r["layers"] if l["type"] == "partials"), {"tracks": [], "gainDb": 0.0})
    y = np.zeros(n_out)
    for ci, cp in enumerate(model["components"]):
        e = E[cp["index"]]
        if e["mute"] >= 0.5:
            continue
        tp, shift = cp["desc"]["peakS"], e["shiftMs"] / 1000
        attack, tail = e["attack"], e["tail"]
        pitch = e["pitchSt"] + e["material"] * sc["material"]["pitchSt"]
        bright = e["bright"] + e["material"] * sc["material"]["brightDbOct"]
        tail = tail * 2 ** (e["material"] * sc["material"]["tailLog2"])
        gain = 10 ** (e["levelDb"] / 20)
        identity = all(abs(e[k] - sc[k]["default"]) < 1e-12 for k in sc)
        # ---- noise part: this component's share of the scale map, edited in time and frequency
        M = model["masks"][ci] * S
        if not identity:
            src = _warp_src(t_frames, tp, shift, attack, tail) / (hop / sr)
            j0 = np.clip(np.floor(src).astype(int), 0, frames_src - 1); j1 = np.clip(j0 + 1, 0, frames_src - 1)
            w = np.clip(src - np.floor(src), 0, 1)
            M = M[:, j0] * (1 - w) + M[:, j1] * w
            M[:, (src < -0.5) | (src > frames_src - 0.5)] = 0.0
            if pitch:
                src_lf = lf - pitch / 12.0
                M = np.stack([np.interp(src_lf, lf, M[:, j], left=0, right=0) for j in range(M.shape[1])], 1)
            if bright:
                M = M * 10 ** (bright * (lf - 10.0) / 20.0)[:, None]
        else:
            M = np.pad(M, ((0, 0), (0, X.shape[1] - M.shape[1])))[:, :X.shape[1]]
        yn = istft(X * M, n_fft, hop, n_out)
        env = lay.get("env")
        src_t = _warp_src(t_samp, tp, shift, attack, tail) if not identity else t_samp
        if env:
            yn = yn * 10 ** (np.interp(src_t, env["t"], env["db"]) / 20.0)
        # ---- partials owned by this component, moved the same way, phase ANCHORED at the component's peak
        yp = np.zeros(n_out)
        inh = e["material"] * sc["material"]["stretch"]
        ratio = 2 ** (pitch / 12)
        f0 = min(min(part["tracks"][i]["hz"]) for i in cp["tracks"]) if cp["tracks"] else 100.0
        g_part = 10 ** (part.get("gainDb", 0.0) / 20.0)
        for j in cp["tracks"]:
            tr = part["tracks"][j]
            if identity:
                yp += render_partials({"tracks": [tr]}, n_out, sr) * g_part
                continue
            yp += _edited_track(tr, n, n_out, sr, tp, shift, attack, tail, ratio, inh, f0, bright) * g_part
        yc = yn + yp
        if r.get("env"):
            yc = yc * 10 ** (np.interp(src_t, r["env"]["t"], r["env"]["db"]) / 20.0)
        y += gain * yc
    return y * 10 ** (r.get("gainDb", 0.0) / 20.0)


def _edited_track(tr, n_src, n_out, sr, tp, shift, attack, tail, ratio, inh, f0, bright):
    """One partial, edited, with its ORIGINAL phase trajectory kept at the component's peak: the edited phase is the
    original phase at the anchor plus the integral of the edited frequency from there. With every slider at its
    default this is exactly render_partials; a small move is a small change (no restart of every phase)."""
    tt = np.asarray(tr["t"], float)
    lo, hi = int(max(0, tt[0] * sr)), int(min(n_src, tt[-1] * sr + 1))
    if hi <= lo + 1:
        return np.zeros(n_out)
    # Original phase in source time (exactly as render_partials builds it), as a function of the source sample.
    seg = np.arange(lo, hi) / sr
    f_src = np.exp(np.interp(seg, tt, np.log(tr["hz"])))
    ph_src = 2 * np.pi * np.cumsum(f_src) / sr + tr.get("phase", 0.0)
    # Output samples covered: the forward image of the track span.
    o0, o1 = _warp_fwd([tt[0], tt[-1]], tp, shift, attack, tail)
    a, b = int(max(0, np.floor(o0 * sr))), int(min(n_out, np.ceil(o1 * sr) + 1))
    if b <= a + 1:
        return np.zeros(n_out)
    t_out = np.arange(a, b) / sr
    s_src = _warp_src(t_out, tp, shift, attack, tail)
    # Mirror render_partials sample for sample: position in source samples from `lo`, fade over 2 ms of samples.
    pos = s_src * sr - lo
    m = hi - lo
    inside = (pos >= -1e-6) & (pos <= m - 1 + 1e-6)
    f_new = np.exp(np.interp(s_src, tt, np.log(tr["hz"])))
    f_new = f0 * (f_new / f0) ** (1 + inh) * ratio
    db = np.interp(s_src, tt, tr["db"]) + bright * np.log2(np.maximum(f_new, 20) / 1000)
    amp = 10 ** (db / 20) * inside
    fade = np.minimum(1.0, np.minimum(pos, m - 1 - pos) / (0.002 * sr))
    amp *= np.clip(fade, 0, 1)
    # Anchor: the output sample whose source time is nearest the peak (or the track start if the peak is outside).
    s_anchor = float(np.clip(tp, lo / sr, (hi - 1) / sr))  # inside the sampled span, so the phase is read, not clamped
    k = int(np.argmin(np.abs(s_src - s_anchor)))
    ph_anchor = np.interp(s_src[k], seg, ph_src)
    cum = 2 * np.pi * np.cumsum(f_new) / sr
    ph = ph_anchor + (cum - cum[k])
    y = np.zeros(n_out)
    y[a:b] = amp * np.sin(ph)
    return y


def solo(model, index, edits=None, seed=None):
    """One component alone (the others muted), edited or not."""
    ed = copy.deepcopy(edits or {})
    for cp in model["components"]:
        if cp["index"] != index:
            ed.setdefault(str(cp["index"]), {})["mute"] = 1.0
    return render(model, ed, seed)


def distance(model, edits, seed=7):
    return edit_distance(model, edits, seed)


def build(recipe: dict, sr: int = 48000, method: str | None = None) -> dict:
    """The decomposition chosen in params/semantic.json (decompose.method), or the one named."""
    m = method or cfg()["decompose"].get("method", "layers")
    return decompose_layers(recipe, sr) if m == "layers" else decompose(recipe, sr)


def summary(model) -> list[dict]:
    return [{"index": cp["index"], "name": cp["name"], **{k: float(cp["desc"][k]) for k in ("peakS", "attackMs", "decayMs", "centroidHz", "tonal", "share")},
             "partials": len(cp["tracks"])} for cp in model["components"]]


