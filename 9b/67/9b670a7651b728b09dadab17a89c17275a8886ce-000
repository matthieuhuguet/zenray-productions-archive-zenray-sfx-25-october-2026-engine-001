def _cos_ramp(x, a, b):
    """0 below a, 1 above b, raised cosine between."""
    return 0.5 - 0.5 * np.cos(np.pi * np.clip((x - a) / max(b - a, 1e-9), 0, 1))


def decompose_layers(recipe: dict, sr: int = 48000) -> dict:
    """Sound design layers instead of a factorisation: the noise is cut into ATTACK (a short window after every
    onset), LOW BODY (under the crossover) and AIR (the rest), by smooth masks that sum to one; the partials are
    grouped into TONES by start time and harmonic family. Every component therefore has a meaning a sound designer
    recognises. FR : couches de métier, attaque, corps grave, souffle, tons."""
    c = cfg()["layers"]
    n = int(round(recipe["seconds"] * sr))
    lay, S = _noise_scale(recipe, n, sr)
    n_fft, hop = lay.get("nFft", 1024), lay.get("hop", 128)
    part = next((l for l in recipe["layers"] if l["type"] == "partials"), {"tracks": []})
    f = np.fft.rfftfreq(n_fft, 1 / sr)
    t = np.arange(S.shape[1]) * hop / sr
    P_noise = (S ** 2) * np.sum(np.hanning(n_fft) ** 2)
    tracks = part["tracks"]
    track_pow = [np.abs(stft(render_partials({"tracks": [tr]}, n, sr), n_fft, hop)) ** 2 for tr in tracks]
    P = P_noise + (sum(track_pow) if track_pow else 0)
    # Onsets: strongest rises of the total level (dB flux), at most maxOnsets, at least minGapMs apart.
    lvl = 10 * np.log10(P.sum(0) + 1e-30)
    flux = np.maximum(np.diff(lvl, prepend=lvl[0]), 0)
    flux[lvl < lvl.max() - c["onsetRangeDb"]] = 0
    onsets = []
    for j in np.argsort(flux)[::-1]:
        if flux[j] < c["onsetMinRiseDb"] or len(onsets) >= c["maxOnsets"]:
            break
        if all(abs(t[j] - o) * 1000 >= c["minGapMs"] for o in onsets):
            onsets.append(float(t[j]))
    onsets = sorted(onsets) or [float(t[int(np.argmax(lvl))])]
    a = c["attackMs"] / 1000
    T = np.zeros_like(t)
    for o in onsets:
        T = np.maximum(T, _cos_ramp(t, o - 0.004, o) * (1 - _cos_ramp(t, o + a, o + a + c["attackFadeMs"] / 1000)))
    L = 1 - _cos_ramp(np.log2(np.maximum(f, 1)), np.log2(c["lowHz"]), np.log2(c["lowHz"] * 2))
    masks = [np.outer(np.ones_like(f), T), np.outer(L, 1 - T), np.outer(1 - L, 1 - T)]
    kinds = ["attack", "low", "air"]
    # Lines first: fragments of one spectral line (overlapping or touching in time, same pitch within lineCents) are
    # one physical partial and must stay in ONE component, or editing one fragment changes its interference with the
    # other (seen 26 October 2026: a 0.1 ms shift moved a 6 kHz tone by 4 dB). Union-find over tracks.
    parent = list(range(len(tracks)))
    def root(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]; i = parent[i]
        return i
    mean_c = [1200 * np.log2(np.exp(np.mean(np.log(tr["hz"])))) for tr in tracks]
    for i in range(len(tracks)):
        for j in range(i + 1, len(tracks)):
            ti, tj = tracks[i]["t"], tracks[j]["t"]
            gap = max(ti[0], tj[0]) - min(ti[-1], tj[-1])
            if gap * 1000 <= c["lineGapMs"] and abs(mean_c[i] - mean_c[j]) <= c["lineCents"]:
                parent[root(i)] = root(j)
    lines = {}
    for j in range(len(tracks)):
        lines.setdefault(root(j), []).append(j)
    # Tones: group lines by start (within groupMs of a group's start) and keep the strongest maxTones groups.
    groups = []
    for members in sorted(lines.values(), key=lambda ms: min(tracks[j]["t"][0] for j in ms)):
        st = min(tracks[j]["t"][0] for j in members)
        g = next((g for g in groups if abs(g["start"] - st) * 1000 <= c["groupMs"]), None)
        if g is None:
            groups.append({"start": st, "tracks": list(members)})
        else:
            g["tracks"] += members
    for g in groups:
        g["energy"] = float(sum(track_pow[j].sum() for j in g["tracks"]))
    groups.sort(key=lambda g: -g["energy"])
    keep, rest = groups[:c["maxTones"]], groups[c["maxTones"]:]
    for g in rest:  # merge small groups into the kept group nearest in time
        near = min(keep, key=lambda k: abs(k["start"] - g["start"]))
        near["tracks"] += g["tracks"]
    keep.sort(key=lambda g: g["start"])
    comps, all_masks = [], []
    zero = np.zeros_like(S)
    for kind, m in zip(kinds, masks):
        pw = (P_noise * m ** 2)
        comps.append({"kind": kind, "tracks": [], "pw": pw})
        all_masks.append(m)
    for g in keep:
        pw = sum(track_pow[j] for j in g["tracks"])
        hz = [float(np.exp(np.mean(np.log(tracks[j]["hz"])))) for j in g["tracks"]]
        top = g["tracks"][int(np.argmax([track_pow[j].sum() for j in g["tracks"]]))]
        hz = [float(np.exp(np.mean(np.log(tracks[top]["hz"]))))]  # label by the loudest partial, not the lowest
        glide = 12 * math.log2(tracks[top]["hz"][-1] / tracks[top]["hz"][0]) if len(tracks[top]["hz"]) > 1 else 0.0
        comps.append({"kind": "tone", "tracks": g["tracks"], "pw": pw, "hz": min(hz), "glide": glide})
        all_masks.append(zero)
    total = sum(float(cp["pw"].sum()) for cp in comps)
    out = []
    for i, cp in enumerate(comps):
        d = describe(cp["pw"].sum(0), cp["pw"].sum(1), f, hop / sr, 1.0 if cp["kind"] == "tone" else 0.0, float(cp["pw"].sum()))
        d["share"] = round(d["energy"] / max(total, 1e-30), 4)
        out.append({"index": i, "tracks": cp["tracks"], "desc": d, "kind": cp["kind"], "hz": cp.get("hz"), "glide": cp.get("glide", 0.0)})
    names = name_layers(out)
    for cp, nm in zip(out, names):
        cp["name"] = nm
    # Drop empty components (no energy), keep masks aligned with indices.
    keep_i = [i for i, cp in enumerate(out) if cp["desc"]["share"] > c["minShare"]]
    dropped = [i for i in range(len(out)) if i not in keep_i]
    if dropped:  # an empty noise layer gives its mask to the air layer so masks still sum to one
        for i in dropped:
            if out[i]["kind"] != "tone":
                all_masks[2] = all_masks[2] + all_masks[i]
            else:
                out[keep_i[0]]["tracks"] += out[i]["tracks"]
    comps_final = [out[i] for i in keep_i]
    masks_final = np.stack([all_masks[i] for i in keep_i])
    for new, cp in enumerate(comps_final):
        cp["index"] = new
    return {"recipe": recipe, "sr": sr, "n": n, "masks": masks_final, "components": comps_final, "nFft": n_fft, "hop": hop,
            "onsets": onsets, "method": "layers"}


def name_layers(comps):
    c = cfg()["naming"]
    names = []
    for cp in comps:
        d = cp["desc"]
        if cp["kind"] == "attack":
            names.append(c["layers"]["attack"])
        elif cp["kind"] == "low":
            names.append(c["layers"]["low"])
        elif cp["kind"] == "air":
            names.append(c["layers"]["airLong"] if d["decayMs"] >= c["tailMinMs"] else c["layers"]["air"])
        else:
            hz = cp["hz"]
            label = f"{hz / 1000:.1f} kHz".replace(".", ",") if hz >= 1000 else f"{hz:.0f} Hz"
            kind = c["layers"]["glide"] if abs(cp["glide"]) >= c["glideSt"] else c["layers"]["tone"]
            names.append(f"{kind} {label}, {d['peakS']:.2f} s".replace(".", ","))
    return names


def edit_distance(model, edits, seed=7):
    """26 October 2026 00:20: LOCAL audibility of an edit: smoothed third-octave levels of the untouched and edited
    renders (same noise draw), the 95th percentile of the absolute dB difference over audible cells. The ear
    notices a local change of about 1 dB; the global perceptual loss dilutes a local change over the whole sound.
    Both are returned. FR : audibilité locale d'une retouche, en dB par tiers d'octave."""
    from .score import score
    p = cfg()["perception"]
    p_db = cfg()["audibility"]
    # Average power over several noise draws: a tone sharing a cell with another component's noise sums differently
    # for each draw, so a single draw turns a phase rotation into a fake "level change" (26 October 2026).
    seeds = [seed + k for k in range(p_db["seeds"])]
    A = [render(model, {}, sd) for sd in seeds]; Bv = [render(model, edits, sd) for sd in seeds]
    n = max(len(A[0]), len(Bv[0]))
    A = [np.pad(v, (0, n - len(v))) for v in A]; Bv = [np.pad(v, (0, n - len(v))) for v in Bv]
    a, b = A[0], Bv[0]
    sr = model["sr"]
    f = np.fft.rfftfreq(2048, 1 / sr)
    edges = 25 * 2 ** (np.arange(0, 31) / 3)
    band = np.clip(np.searchsorted(edges, f) - 1, 0, len(edges) - 2)
    def tob(x):
        P = np.abs(stft(x, 2048, 256)) ** 2
        Bp = np.zeros((len(edges) - 1, P.shape[1]))
        np.add.at(Bp, band, P)
        from scipy.ndimage import uniform_filter
        return 10 * np.log10(np.maximum(uniform_filter(Bp, size=(3, 5), mode="nearest"), 0) + 1e-30)
    def tob_mean(vs):
        from scipy.ndimage import uniform_filter
        acc = None
        for x in vs:
            P = np.abs(stft(x, 2048, 256)) ** 2
            Bp = np.zeros((len(edges) - 1, P.shape[1])); np.add.at(Bp, band, P)
            acc = Bp if acc is None else acc + Bp
        return 10 * np.log10(np.maximum(uniform_filter(acc / len(vs), size=(3, 5), mode="nearest"), 0) + 1e-30)
    da, db = tob_mean(A), tob_mean(Bv)
    top = max(da.max(), db.max())
    # Floor both at 60 dB under the peak: -150 against -60 dB is a "90 dB change" nobody can hear.
    da, db = np.maximum(da, top - 60), np.maximum(db, top - 60)
    # Audible cells only: bands above 40 Hz and within 40 dB of the peak (quieter cells are masked by the loud part
    # of an effect; seen on Mail Open, 26 October 2026: a 25 Hz band at -59 dB read as a "9 dB" jump).
    live = (np.maximum(da, db) > top - p_db["rangeDb"]) & (edges[:-1] >= p_db["minHz"])[:, None]
    # The largest smoothed change where the sound is audible: a short component changes few cells, and a percentile
    # over the whole sound would call a 6 dB move on it "0 dB" (seen on Cufflinks Open, 26 October 2026).
    diff = np.abs(da - db)
    peak = float(diff[live].max()) if live.any() else 0.0
    # Loudness-weighted mean change: each audible cell weighs its power (the louder of the two), so a change in the
    # loud body of the sound counts and a partial moved in a quiet corner barely does (26 October 2026: the peak
    # alone called every frequency move "franc", 40 dB, because a partial leaves one band for another).
    w = 10 ** (np.maximum(da, db) / 10) * live
    mean = float((diff * w).sum() / max(w.sum(), 1e-30))
    word = next(x["word"] for x in p if mean < x["belowDb"])
    g = score(b, a, sr)
    return {"localDb": round(mean, 2), "peakDb": round(peak, 2), "word": word, "globalJnd": round(g["invariantE"], 2)}
