# 26 October 2026: the six proposals of the sound of "ZenRay, Sony puis PlayStation, rythme D" (6 s), as ZenRay SFX briefs.
# Two tracks: sfx1 (lens on the R) and sfx2 (progress, from 3 s), three proposals each (A, B, C). Every instant is an
# offset in seconds from the start of its track; the track start and the film cues it must meet are in "placement".
# The briefs are plain data (events with partials, noise colours, envelopes): open them in ZenRay Edit and move any number.
# Design notes: written from sound design practice (attack, body, tail, sweetener), no audio of any game or film is used.
# FR : les six propositions sonores du rythme D, sous forme de briefs ; chaque instant est un décalage depuis le début de sa piste.
# Usage: /usr/bin/python3 Scripts/DesignRhythmD.py   (rewrites params/proposals/zenray-sony-playstation-d-ppm.json)
import json, math, sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]; sys.path.insert(0, str(ROOT))
from zrsfx import brief as B

# Film cues (seconds), measured by Scripts/Storyboard.py. Read from cues.json, never typed twice.
CUES = json.loads((ROOT / "out/motion/zenray-sony-playstation-d-ppm/cues.json").read_text())["cues"]

# Octave colours, 31.5 Hz to 16 kHz (dB, 0 = loudest octave).
AIR_HI = [-60, -60, -52, -38, -26, -14, -5, 0, -1, -5]       # bright air, a breath of light
AIR_MID = [-60, -52, -32, -17, -7, 0, -4, -12, -26, -42]     # mid breath
HISS = [-60, -60, -60, -52, -38, -22, -9, -2, 0, -2]         # fine high hiss
SUB = [-2, 0, -7, -26, -52, -60, -60, -60, -60, -60]         # chest
THUD = [-8, 0, -2, -9, -20, -34, -48, -60, -60, -60]         # low hit body
CLICK = [-60, -60, -60, -50, -34, -16, -3, 0, -3, -10]       # tiny digital click

def tone(hz, partials, level, glide=0.0, stretch=0.0):
    assert all(float(k) == int(k) for k, _ in partials), "partial numbers are integers (text keeps ints)"
    return {"hz": hz, "glide": glide, "partials": [[k, r] for k, r in partials], "level": level, "stretch": stretch, "harmonics": 1, "tilt": 0.0}

def noise(colour, level, sweep=0.0):
    return {"colour": colour, "sweep": sweep, "level": level, "hz": 1000.0, "width": 3.0, "tilt": 0.0}

def ev(t, pts, tone_=None, noise_=None):
    return B.event(round(t, 4), tone=tone_, noise=noise_, env={"points": [[round(a, 1), b] for a, b in pts]})

SAW = [(k, -6.0 * math.log2(k)) for k in range(1, 13)]                  # sawtooth-like stack, 6 dB per octave
GLASS = [(1, 0), (2, -14), (3, -22), (5, -30)]                          # soft glass tone
BELL = [(1, 0), (2.756, -6), (5.404, -11), (8.933, -17)]                 # inharmonic modal bell (ratios of a free bar)

def bell(t, hz, level, decay_ms, attack_ms=2.0):
    """A modal bell: partials at the free-bar ratios (non-integer ratios are written as stretched integers below)."""
    out = []
    for ratio, rel in [(1.0, 0), (2.756, -7), (5.404, -12), (8.933, -18)]:
        out.append(ev(t, [[0, -60], [attack_ms, 0], [decay_ms * 0.25, -14 - 0.3 * (ratio * 3)], [decay_ms, -60]], tone(hz * ratio, [(1, 0)], level + rel)))
    return out

# ---------------------------------------------------------------- SFX 1: the lens on the R
# Track start 0.35 s; instants below are offsets. firstLight=+0.067, lightFull=+0.50, wordSpread=+1.167, lens=+1.317, blue=+1.833, beam=+1.983.
S1 = 0.35
o = lambda cue: round(CUES[cue] - S1, 4)

def sfx1_A():  # glass and lens
    e = []
    e.append(ev(o("firstLight"), [[0, -60], [3, 0], [60, -18], [140, -60]], tone(3180, [(1, 0), (2, -8), (3, -12)], -24)))       # ignition tick
    e.append(ev(o("firstLight"), [[0, -60], [25, 0], [90, -60]], None, noise(HISS, -28)))
    e.append(ev(o("firstLight") + 0.02, [[0, -60], [430, -14], [560, -26], [900, -60]], tone(1760, GLASS, -26, glide=2.0)))             # glass swell on the lit R
    e.append(ev(o("lightFull") - 0.05, [[0, -60], [380, -30], [620, -60]], tone(2349, GLASS, -32)))
    e.append(ev(o("lightFull"), [[0, -60], [760, -20], [900, -44], [1000, -60]], None, noise(AIR_HI, -34, sweep=1.4)))                   # air rises toward the lens
    e.append(ev(o("wordSpread"), [[0, -60], [30, -8], [300, -28], [520, -60]], tone(1108, GLASS, -26, glide=7)))                       # light jumps to the neighbours
    e.append(ev(o("lens"), [[0, -60], [3, 0], [80, -12], [420, -42], [900, -60]], None, noise(THUD, -12)))                                # lens thump
    e.append(ev(o("lens"), [[0, -60], [4, 0], [160, -16], [600, -60]], tone(58, [(1, 0), (2, -9)], -14, glide=-3)))
    e += bell(o("lens"), 2093, -22, 1300)                                                                                                # the lens flare, a bright bell
    e.append(ev(o("lens") + 0.02, [[0, -60], [220, -10], [1100, -60]], None, noise(HISS, -30, sweep=-0.4)))                              # sparkles of the flare
    return e

def sfx1_B():  # Sony cinema: a drone swells and one deep hit
    e = []
    for f, rel, lvl, att in ((55.0, 0, -18, 1250), (82.4, -4, -24, 1000), (110.0, -6, -26, 900)):
        e.append(ev(o("firstLight"), [[0, -60], [att, 0], [att + 160, -6], [att + 900, -60]], tone(f, [(1, 0), (2, -7), (3, -12), (4, -16)], lvl + rel)))
    for det in (1.0, 1.0035):
        e.append(ev(o("lightFull") - 0.1, [[0, -60], [950, -6], [1050, -8], [1700, -60]], tone(220.0 * det, SAW, -34)))                 # string-like stack, detuned pair
    e.append(ev(o("lightFull"), [[0, -60], [820, -16], [1000, -50]], None, noise(AIR_MID, -38, sweep=1.0)))
    e.append(ev(o("lens"), [[0, -60], [6, 0], [220, -10], [1300, -60]], None, noise(THUD, -10)))                                          # the deep hit
    e.append(ev(o("lens"), [[0, -60], [5, 0], [420, -14], [1300, -60]], tone(48, [(1, 0), (2, -8), (3, -14)], -10, glide=-7)))
    e.append(ev(o("lens") + 0.01, [[0, -60], [8, 0], [90, -22], [500, -60]], None, noise(CLICK, -26)))
    e += bell(o("lens"), 1568, -28, 1900)
    return e

def sfx1_C():  # minimal: a drop, a breath, one bell
    e = []
    e.append(ev(o("firstLight"), [[0, -60], [80, 0], [900, -20], [1400, -60]], tone(1318.5, [(1, 0), (2, -16)], -26)))
    e.append(ev(o("lightFull"), [[0, -60], [90, 0], [800, -22], [1300, -60]], tone(2637, [(1, 0), (2, -18)], -32)))
    e.append(ev(o("firstLight") + 0.05, [[0, -60], [880, -9], [1100, -22], [1300, -60]], None, noise(AIR_MID, -42, sweep=0.8)))
    e.append(ev(o("lens") - 0.03, [[0, -60], [30, -3], [200, -60]], None, noise(HISS, -36)))
    e += bell(o("lens"), 880, -20, 2100, attack_ms=3.0)
    e.append(ev(o("lens"), [[0, -60], [20, 0], [260, -20], [900, -60]], tone(52, [(1, 0)], -18)))                                         # soft heartbeat
    e.append(ev(o("lens") + 0.012, [[0, -60], [6, 0], [60, -60]], tone(4186, [(1, 0)], -28)))
    return e

# ---------------------------------------------------------------- SFX 2: progress toward another dimension, from 3.0 s
# Track start 3.0 s; flarePeak=+0.15, flareGone=+0.467, tileAppears=+0.733, whiteFlip=+0.883, aberration +1.417 to +2.417, fade +2.283 to +2.95.
S2 = 3.0
q = lambda cue: round(CUES[cue] - S2, 4)

def clicks(t0, t1, n, hz, level, curve=1.8):
    """A loading bar: n digital ticks between t0 and t1, closer and closer together (curve > 1)."""
    out = []
    for i in range(n):
        u = (i / (n - 1)) ** curve
        t = t0 + (t1 - t0) * u
        out.append(ev(t, [[0, -60], [1.0, 0], [14, -26], [40, -60]], tone(hz * (1 + 0.5 * i / n), [(1, 0), (3, -10)], level + 3 * (i / n))))
    return out

def sfx2_A():  # dimensional loading
    e = []
    e.append(ev(0.0, [[0, -60], [q("flarePeak") * 1000, 0], [q("flareGone") * 1000, -60]], None, noise(AIR_HI, -24, sweep=0.6)))        # the flare blooms to its peak, gone with the flare
    e.append(ev(0.0, [[0, -60], [880, -8], [940, -60]], tone(220, [(1, 0), (2, -8), (3, -14)], -26, glide=36)))                        # three octaves of charge
    e.append(ev(0.05, [[0, -60], [820, -14], [860, -60]], None, noise(HISS, -34, sweep=1.5)))
    e += clicks(0.05, q("whiteFlip") - 0.04, 14, 2400, -34)
    e.append(ev(q("tileAppears"), [[0, -60], [120, -10], [300, -60]], None, noise(AIR_MID, -28, sweep=1.0)))                           # plate swings in
    e.append(ev(q("whiteFlip"), [[0, -60], [6, 0], [220, -10], [1500, -60]], None, noise(THUD, -4)))                                   # arrival
    e.append(ev(q("whiteFlip"), [[0, -60], [8, 0], [700, -14], [1900, -60]], tone(46, [(1, 0), (2, -8), (3, -16)], -5, glide=-5)))
    for hz in (659.3, 987.8, 1480.0, 1975.5):                                                                                           # glass chord, E5 B5 F#6 B6
        e.append(ev(q("whiteFlip"), [[0, -60], [6, 0], [500, -12], [1900, -60]], tone(hz, GLASS, -20)))
    e.append(ev(q("whiteFlip"), [[0, -60], [14, 0], [80, -24], [900, -60]], None, noise(HISS, -22, sweep=-0.5)))
    e.append(ev(q("aberrationStart"), [[0, -60], [30, 0], [330, -26], [420, -60]], tone(2200, [(1, 0), (2, -9)], -18, glide=-20)))        # the dimension tears
    e.append(ev(q("aberrationStart"), [[0, -60], [70, -4], [900, -24], [1000, -60]], None, noise(HISS, -26, sweep=0.2)))
    e.append(ev(q("settle") + 0.05, [[0, -60], [400, -8], [1200, -20], [2200, -60]], tone(329.6, GLASS, -34)))                         # sustained pad under the fade
    return e

def sfx2_B():  # portal: reverse swell, falling drone, one clean ring
    e = []
    e.append(ev(0.0, [[0, -60], [100, -6], [900, -2], [930, -60]], None, noise(AIR_HI, -40, sweep=1.2)))                              # reverse swell
    e.append(ev(0.0, [[0, -60], [160, -10], [880, -8], [920, -60]], tone(150, [(1, 0), (2, -6), (3, -12), (4, -18)], -22, glide=-24)))      # falling into depth
    e.append(ev(0.0, [[0, -60], [q("flarePeak") * 1000, 0], [q("flareGone") * 1000, -60]], None, noise(AIR_MID, -20, sweep=1.6)))       # whoosh of the flare, peak on the flare peak
    e.append(ev(q("tileAppears"), [[0, -60], [4, 0], [180, -16], [420, -60]], tone(1046.5, GLASS, -24, glide=5)))                      # glass pluck
    e += bell(q("whiteFlip"), 1318.5, -18, 2300)                                                                                         # the clean ring
    e.append(ev(q("whiteFlip"), [[0, -60], [5, 0], [260, -12], [1100, -60]], None, noise(THUD, -9)))
    e.append(ev(q("whiteFlip"), [[0, -60], [6, 0], [600, -14], [1600, -60]], tone(41, [(1, 0), (2, -9)], -9)))
    for i in range(10):                                                                                                                   # flutter under the aberration
        e.append(ev(q("aberrationStart") + 0.075 * i, [[0, -60], [6, -2 - i * 1.4], [40, -60]], None, noise(CLICK, -18 - i * 1.0)))
    e.append(ev(q("aberrationStart") + 0.05, [[0, -60], [140, -8], [1500, -26], [1650, -60]], tone(1760, GLASS, -36)))
    return e

def sfx2_C():  # minimal: a heartbeat that accelerates, a thin charge, a calm chord
    e = []
    for tt, lvl in ((q("flarePeak"), -14), (q("flareGone"), -13), (q("tileAppears"), -12), (q("whiteFlip"), -10)):   # one beat per visual beat, closer and closer
        e.append(ev(tt, [[0, -60], [4, 0], [90, -14], [260, -60]], tone(52, [(1, 0), (2, -10)], lvl)))
    e.append(ev(0.0, [[0, -60], [840, -10], [900, -60]], tone(1200, [(1, 0), (2, -20)], -34, glide=18)))                               # thin charge
    e.append(ev(0.0, [[0, -60], [700, -16], [900, -60]], None, noise(AIR_MID, -44, sweep=0.8)))
    e.append(ev(0.0, [[0, -60], [q("flarePeak") * 1000, 0], [q("flareGone") * 1000, -60]], None, noise(AIR_MID, -30, sweep=0.5)))     # a quiet bloom for the flare
    for hz, lv in ((392.0, -26), (587.3, -28), (880.0, -28), (1318.5, -30), (1760.0, -34)):                                           # G major 9
        e.append(ev(q("whiteFlip"), [[0, -60], [90, 0], [1200, -10], [2200, -60]], tone(hz, [(1, 0), (2, -16)], lv)))
    e.append(ev(q("whiteFlip"), [[0, -60], [40, -6], [400, -28], [900, -60]], None, noise(HISS, -34)))
    e.append(ev(q("aberrationStart"), [[0, -60], [8, -4], [900, -12], [1000, -60]], tone(2400, [(1, 0)], -24)))                       # beating pair, 32 Hz apart
    e.append(ev(q("aberrationStart"), [[0, -60], [8, -4], [900, -12], [1000, -60]], tone(2432, [(1, 0)], -24)))
    return e

SPEC = {
  "film": "zenray-sony-playstation-d-ppm",
  "tracks": {
    "sfx1": {"label": "La lentille sur le R", "start": S1, "seconds": 2.45, "anchors": [{"cue": "firstLight", "role": "begin"}, {"cue": "lens", "role": "onset"}],
             "proposals": {"A": ("Verre et lentille", sfx1_A, 0.45), "B": ("Cinéma, nappe et coup grave", sfx1_B, 0.55), "C": ("Minimal, une cloche", sfx1_C, 0.55)}},
    "sfx2": {"label": "Progression vers une autre dimension", "start": S2, "seconds": 3.0, "anchors": [{"cue": "flarePeak", "role": "hit"}, {"cue": "whiteFlip", "role": "onset"}, {"cue": "aberrationStart", "role": "band"}],
             "proposals": {"A": ("Chargement dimensionnel", sfx2_A, 0.5), "B": ("Portail", sfx2_B, 0.5), "C": ("Minimal, battement et accord", sfx2_C, 0.5)}},
  },
}

def build():
    out = {"film": SPEC["film"], "date": "26 October 2026", "cues": CUES, "tracks": {}}
    for tid, tr in SPEC["tracks"].items():
        out["tracks"][tid] = {"label": tr["label"], "start": tr["start"], "anchors": tr["anchors"], "proposals": {}}
        for k, (name, fn, space) in tr["proposals"].items():
            br = {"name": f"{tid}-{k}", "seconds": tr["seconds"], "seed": 0, "events": fn(), "space": space}
            assert B.to_text(B.from_text(B.to_text(br))) == B.to_text(br), f"{tid}-{k}: text round trip"
            out["tracks"][tid]["proposals"][k] = {"name": name, "brief": br}
    return out

if __name__ == "__main__":
    spec = build()
    (ROOT / "params/proposals/zenray-sony-playstation-d-ppm.json").write_text(json.dumps(spec, indent=1, ensure_ascii=False))
    print({t: {k: len(v["brief"]["events"]) for k, v in tr["proposals"].items()} for t, tr in spec["tracks"].items()})
