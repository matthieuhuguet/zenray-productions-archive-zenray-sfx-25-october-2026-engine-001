# 25 October 2026 15:30: ZenRay SFX renderer. A recipe (plain JSON, no audio inside) becomes a waveform.
# Layers: "noise" (seeded white noise shaped by a coarse band x keyframe grid in dB), "partials" (sinusoids whose
# frequency and level follow a few breakpoints), "click" (short filtered impulse). Effects: gain, reverb tail.
# FR : le moteur de rendu. Une recette JSON, sans aucun audio, devient une forme d'onde.
from __future__ import annotations

import numpy as np

SR = 48000


def band_edges(lo: float, hi: float, n: int) -> np.ndarray:
    return np.geomspace(lo, hi, n + 1)


def band_centres(lo: float, hi: float, n: int) -> np.ndarray:
    e = band_edges(lo, hi, n)
    return np.sqrt(e[:-1] * e[1:])


def stft(x: np.ndarray, n_fft: int, hop: int) -> np.ndarray:
    win = np.hanning(n_fft)
    pad = np.concatenate([np.zeros(n_fft // 2), x, np.zeros(n_fft)])
    count = 1 + (len(pad) - n_fft) // hop
    idx = np.arange(n_fft)[None, :] + hop * np.arange(count)[:, None]
    return np.fft.rfft(pad[idx] * win, axis=1).T  # (bins, frames)


def istft(X: np.ndarray, n_fft: int, hop: int, length: int) -> np.ndarray:
    win = np.hanning(n_fft)
    frames = np.fft.irfft(X.T, n=n_fft, axis=1) * win
    out = np.zeros(hop * (frames.shape[0] - 1) + n_fft)
    norm = np.zeros_like(out)
    for i, f in enumerate(frames):
        out[i * hop:i * hop + n_fft] += f
        norm[i * hop:i * hop + n_fft] += win * win
    out /= np.maximum(norm, 1e-8)
    return out[n_fft // 2:n_fft // 2 + length]


def grid_to_bins(grid_db: np.ndarray, times: np.ndarray, lo: float, hi: float, n_fft: int, hop: int,
                 frames: int, sr: int) -> np.ndarray:
    """Interpolate a band x keyframe dB grid onto the STFT bins x frames (linear in log frequency and in time)."""
    nb = grid_db.shape[0]
    centres = np.log(band_centres(lo, hi, nb))
    f = np.fft.rfftfreq(n_fft, 1 / sr)
    lf = np.log(np.maximum(f, 1.0))
    t = np.arange(frames) * hop / sr
    over_t = np.stack([np.interp(t, times, row) for row in grid_db])  # (bands, frames)
    out = np.empty((len(f), frames))
    for j in range(frames):
        out[:, j] = np.interp(lf, centres, over_t[:, j])
    out[(f < lo * 0.7) | (f > hi * 1.3)] = -160.0
    return out


def render_noise(layer: dict, n: int, sr: int, seed: int) -> np.ndarray:
    n_fft, hop = layer.get("nFft", 1024), layer.get("hop", 128)
    rng = np.random.default_rng(seed)
    X = stft(rng.standard_normal(n), n_fft, hop)
    g = np.asarray(layer["grid"], float)
    times = np.asarray(layer["times"], float)
    gain_db = grid_to_bins(g, times, layer["lo"], layer["hi"], n_fft, hop, X.shape[1], sr)
    # Unit-variance white noise has a per-bin power of sum(win^2); the grid holds band power per bin in dB.
    scale = 10 ** (gain_db / 20.0) / np.sqrt(np.sum(np.hanning(n_fft) ** 2))
    y = istft(X * scale, n_fft, hop, n)
    env = layer.get("env")
    if env:
        # Fine broadband gain curve (dB breakpoints), the temporal detail the coarse grid cannot hold.
        y *= 10 ** (np.interp(np.arange(n) / sr, env["t"], env["db"]) / 20.0)
    return y


def _path(times, values, t, log=False):
    v = np.log(values) if log else np.asarray(values, float)
    out = np.interp(t, times, v)
    return np.exp(out) if log else out


def render_partials(layer: dict, n: int, sr: int) -> np.ndarray:
    t = np.arange(n) / sr
    y = np.zeros(n)
    for p in layer["tracks"]:
        tt = np.asarray(p["t"], float)
        lo, hi = int(max(0, tt[0] * sr)), int(min(n, tt[-1] * sr + 1))
        if hi <= lo + 1:
            continue
        seg = t[lo:hi]
        f = _path(tt, p["hz"], seg, log=True)
        a = 10 ** (_path(tt, p["db"], seg) / 20.0)
        # 2 ms fades so a track never clicks on and off.
        fade = np.minimum(1.0, np.minimum(np.arange(hi - lo), np.arange(hi - lo)[::-1]) / (0.002 * sr))
        phase = 2 * np.pi * np.cumsum(f) / sr + p.get("phase", 0.0)
        y[lo:hi] += a * fade * np.sin(phase)
    return y


def render_click(layer: dict, n: int, sr: int, seed: int) -> np.ndarray:
    y = np.zeros(n)
    rng = np.random.default_rng(seed)
    for c in layer["hits"]:
        k = int(c["t"] * sr)
        m = int(c.get("ms", 3.0) * sr / 1000)
        if k >= n or m < 2:
            continue
        burst = rng.standard_normal(m) * np.exp(-np.arange(m) / (m / 4.0))
        y[k:k + m] += 10 ** (c["db"] / 20.0) * burst[:n - k]
    return y


def render_layer(layer: dict, n: int, sr: int, seed: int) -> np.ndarray:
    kind = layer["type"]
    if kind == "noise":
        y = render_noise(layer, n, sr, seed)
    elif kind == "partials":
        y = render_partials(layer, n, sr)
    elif kind == "click":
        y = render_click(layer, n, sr, seed)
    else:
        raise ValueError(f"unknown layer type: {kind}")
    return y * 10 ** (layer.get("gainDb", 0.0) / 20.0)


def render(recipe: dict, sr: int = SR, seed: int | None = None) -> np.ndarray:
    """Mono float64 waveform of a recipe. seed overrides recipe['seed'] (a new take of the same sound)."""
    n = int(round(recipe["seconds"] * sr))
    s = recipe.get("seed", 0) if seed is None else seed
    y = np.zeros(n)
    for i, layer in enumerate(recipe["layers"]):
        if layer.get("mute"):
            continue
        y += render_layer(layer, n, sr, s * 1009 + i)
    env = recipe.get("env")
    if env:
        # Master gain curve over the whole mix (dB breakpoints): closes pre-echo and tails of every layer at once.
        y *= 10 ** (np.interp(np.arange(n) / sr, env["t"], env["db"]) / 20.0)
    return y * 10 ** (recipe.get("gainDb", 0.0) / 20.0)
