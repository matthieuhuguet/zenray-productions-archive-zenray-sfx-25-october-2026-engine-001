# 25 October 2026 17:05: reference vs reproduction mel spectrograms, one row per sound, with the scores.
# FR : planche référence contre reproduction, une ligne par son.
import sys, json, glob; from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import numpy as np, soundfile as sf, librosa
from PIL import Image, ImageDraw
run = Path(sys.argv[1]); refs = Path(sys.argv[2] if len(sys.argv) > 2 else "refs")
rows = {r["ref"]: r for r in json.load(open(run / "results.json"))}
W, H, PAD = 560, 220, 24
def spec(y, sr, secs):
    M = librosa.power_to_db(librosa.feature.melspectrogram(y=y, sr=sr, n_fft=2048, hop_length=128, n_mels=160), ref=1.0)
    a = np.clip((M + 90) / 90, 0, 1)[::-1]
    return Image.fromarray((np.stack([a ** 0.6, a ** 1.5, a ** 3], -1) * 255).astype(np.uint8)).resize((W, H))
names = sorted(rows)
sheet = Image.new("RGB", (2 * W + 30, len(names) * (H + PAD) + 30), "white"); d = ImageDraw.Draw(sheet)
d.text((10, 8), "Reference (left)  |  ZenRay SFX recipe render, held-out seed 7 (right)", fill="black")
for i, n in enumerate(names):
    x, sr = sf.read(refs / f"{n}.wav"); y, _ = sf.read(run / f"{n}.wav")
    y0 = 30 + i * (H + PAD); r = rows[n]
    d.text((10, y0), f"{n}   held-out invariant {r['heldInvariant']}  ceiling {r['ceiling']}  exact {r['heldExact']}  numbers {r['params']}", fill="black")
    sheet.paste(spec(x, sr, len(x) / sr), (10, y0 + 16)); sheet.paste(spec(y, sr, len(x) / sr), (20 + W, y0 + 16))
sheet.save(run / "compare.png"); print(run / "compare.png")
