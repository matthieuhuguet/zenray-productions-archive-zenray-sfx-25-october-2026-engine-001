# 26 October 2026: nine SOFT variations of sfx2-E1 (Death Stranding Timefall shelter), asked by Matthieu: "very classy and very soft,
# a bit PlayStation and Hideo Kojima". Written from sound design practice: a veil of the original pad (stretched, low-passed, a
# room tail, a slow swell that crests at the aberration and closes to silence), optionally a soft low swell, a breath of air or
# a few sparse glass notes. Every number is in params/soft-e1.json. FR : neuf variations très douces de sfx2-E1.
# Usage: /usr/bin/python3 Scripts/DesignRhythmD4.py   (writes out/proposals/<film>/sfx2-F1..F9.wav, sheet-v4.png, measures-v4.json, params/proposals/<film>.v4.json)
import json, re, subprocess, sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]; sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(ROOT / "Scripts"))
import numpy as np, soundfile as sf, librosa
from scipy.signal import butter, sosfiltfilt, fftconvolve
import DesignRhythmD as D
import DesignRhythmD2 as D2

SR, FILM, OUT = 48000, D.SPEC["film"], ROOT / "out/proposals" / D.SPEC["film"]
P = json.loads((ROOT / "params/soft-e1.json").read_text())
CLIMAX = D.q("aberrationStart")
rms = lambda y: float(np.sqrt((y ** 2).mean()) + 1e-12)
db = lambda x: 10 ** (x / 20)

def lowpass(y, hz): return sosfiltfilt(butter(4, hz, "low", fs=SR, output="sos"), y).astype(np.float32)
def bandpass(y, lo, hi): return sosfiltfilt(butter(4, [lo, hi], "band", fs=SR, output="sos"), y).astype(np.float32)

def swell(n, peak_at, out_from, rise=1.6):
    """The gentle gain curve: a slow raised-cosine rise to the crest, a long release, silence at 2.95 s."""
    t = np.arange(n) / SR; g = np.zeros(n)
    up = t <= peak_at; g[up] = np.sin(0.5 * np.pi * t[up] / peak_at) ** rise
    dn = ~up; u = np.clip((t[dn] - peak_at) / (2.95 - peak_at), 0, 1); g[dn] = (0.5 * (1 + np.cos(np.pi * u))) ** 1.3
    return g.astype(np.float32)

def reverb(y, sec, wet, seed=3):
    n = int(sec * SR); r = np.random.default_rng(seed).standard_normal(n); t = np.arange(n) / SR
    ir = lowpass((r * np.exp(-6.9 * t / sec)).astype(np.float32), 4500); ir /= np.sqrt((ir ** 2).sum())
    return ((1 - wet) * y + wet * fftconvolve(y, ir)[:len(y)]).astype(np.float32)

def render(v):
    p = {**P["defaults"], **v}; n = 3 * SR
    src, sr = sf.read(ROOT / "refs/15-TimeFall-Shelter.wav", dtype="float32"); assert sr == SR
    if p["pitchSt"]: src = librosa.resample(src, orig_sr=SR, target_sr=int(round(SR / 2 ** (p["pitchSt"] / 12)))); src = librosa.resample(src, orig_sr=int(round(SR / 2 ** (p["pitchSt"] / 12))), target_sr=SR) if False else src
    # pitch by resampling the stretch ratio: stretch then play at the transposed rate keeps the length: do it as time_stretch + resample
    st = librosa.effects.time_stretch(src, rate=len(src) / SR / min(2.7, 1.65 * p["stretch"]) * (1.65 / (len(src) / SR)) * 1.0) if False else librosa.effects.time_stretch(src, rate=1.0 / p["stretch"])
    if p["pitchSt"]:
        k = 2 ** (p["pitchSt"] / 12); st = librosa.resample(st, orig_sr=SR * k, target_sr=SR)  # speed change = pitch change
    pad = np.zeros(n, np.float32); pad[:min(n, len(st))] = st[:n]
    pad = lowpass(pad, p["lowpassHz"]); pad = reverb(pad, p["verbSec"], p["verbWet"])
    pad *= swell(n, p["peakAt"], p["fadeOutFrom"], p["rise"]); ref = rms(pad[int((p["peakAt"] - 0.3) * SR):int((p["peakAt"] + 0.3) * SR)])
    t = np.arange(n) / SR; g = swell(n, p["peakAt"], p["fadeOutFrom"], p["rise"]); mix = pad.copy()
    if p["subDb"] is not None:
        f = p["subHz"] * (1 + (p["subRise"] - 1) * np.clip(t / p["peakAt"], 0, 1)); ph = 2 * np.pi * np.cumsum(f) / SR
        sub = (np.sin(ph) + 0.25 * np.sin(2 * ph)).astype(np.float32) * g ** 1.5; mix += sub / rms(sub[g > 0.5]) * ref * db(p["subDb"])
    if p["airDb"] is not None:
        air = bandpass(np.random.default_rng(5).standard_normal(n).astype(np.float32), 5000, 11000) * g ** 2; mix += air / rms(air[g > 0.5]) * ref * db(p["airDb"])
    for at, hz, lvl in p["notes"]:
        k = np.arange(int(2.0 * SR)) / SR; env = np.minimum(k / 0.04, 1.0) ** 2 * np.exp(-k / 0.55)
        note = sum(a * np.sin(2 * np.pi * hz * m * k) for m, a in ((1, 1.0), (2, 0.18), (3, 0.05))) * env
        a0 = int(at * SR); seg = note[:max(0, n - a0)].astype(np.float32); seg = reverb(np.pad(seg, (0, 0)), 1.2, 0.3)[:len(seg)]
        mix[a0:a0 + len(seg)] += seg / (np.abs(seg).max() + 1e-9) * ref * 1.4 * db(lvl)
    m = int(0.5 * SR); mix[-m:] *= 0.5 * (1 + np.cos(np.pi * np.arange(m) / m))      # the very end closes on silence, notes included
    return mix.astype(np.float32)

def lufs(f):
    r = subprocess.run(["ffmpeg", "-nostats", "-i", str(f), "-af", "ebur128=peak=true", "-f", "null", "-"], capture_output=True, text=True)
    return float(re.findall(r"I:\s+(-?\d+\.\d+) LUFS", r.stderr)[-1])

def softness(y):
    """Objective softness: the steepest rise in 100 ms (dB), the step at the climax, the spectral centroid and the instant of the crest."""
    k = int(0.1 * SR); e = np.array([20 * np.log10(rms(y[i:i + k])) for i in range(0, len(y) - k, k // 2)]); live = e > e.max() - 35
    jump = D2.jump(y, CLIMAX); cen = float(np.mean(librosa.feature.spectral_centroid(y=y, sr=SR)[0]))
    return {"maxRiseDb100ms": round(float(np.max(np.diff(e)[live[1:] & live[:-1]])), 1), "jumpAtClimaxDb": jump, "centroidHz": int(cen), "crestAt": round((int(np.argmax(e)) * (k // 2) + k / 2) / SR, 2),
            "endsSilent": bool(np.abs(y[-int(0.05 * SR):]).max() < 1e-4)}

def main():
    made, rows, props = {}, {}, {}
    e1, _ = sf.read(OUT / "sfx2-E1.wav", dtype="float32"); made[("sfx2", "E1")] = ("E1 d'origine, sans retouche", e1, D.S2)
    for key, v in P["variants"].items():
        for _ in range(4):      # move the swell until the crest lands where it is wanted
            y = render(v); crest = softness(y)["crestAt"]; want = {**P["defaults"], **v}["crestTarget"]
            if abs(crest - want) <= 0.08: break
            v = {**v, "peakAt": float(np.clip({**P["defaults"], **v}["peakAt"] + (want - crest), 0.9, 2.0))}
        P["variants"][key] = v; f = OUT / f"sfx2-{key}.wav"; sf.write(f, y, SR, subtype="PCM_24"); g = P["targetLufs"] - lufs(f); y = y * db(g)
        assert np.abs(y).max() < db(-3), f"{key}: peak too high"
        sf.write(f, y, SR, subtype="PCM_24"); made[("sfx2", key)] = (v["name"], y, D.S2)
        rows[key] = {"name": v["name"], "lufs": round(lufs(f), 2), "peakDb": round(float(20 * np.log10(np.abs(y).max())), 2), **softness(y)}
        props[key] = {"name": v["name"], "hitAt": rows[key]["crestAt"], "note": "variation douce de sfx2-E1"}; print(key, rows[key])
    rows["E1"] = {"name": "E1", "lufs": round(lufs(OUT / "sfx2-E1.wav"), 2), **softness(e1)}; print("E1 (référence)", rows["E1"])
    (OUT / "measures-v4.json").write_text(json.dumps(rows, indent=1, ensure_ascii=False))
    D2.sheet(made, "sheet-v4.png")
    (ROOT / "params/proposals" / f"{FILM}.v4.json").write_text(json.dumps({"film": FILM, "date": "26 October 2026", "cues": D.CUES, "tracks": {"sfx2": {"label": "Progression vers une autre dimension", "start": D.S2, "main": "aberrationStart", "anchors": [{"cue": "aberrationStart", "role": "band"}], "proposals": props}}}, indent=1, ensure_ascii=False))

if __name__ == "__main__":
    main()
