# crackling reproduction = 3.18. FR : indice de grésillement. Usage: /usr/bin/python3 Scripts/CrackleIndex.py file.wav [...]
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import soundfile as sf
from zrsfx.crackle import crackle, hf_level

if __name__ == "__main__":
    for p in sys.argv[1:]:
        y, sr = sf.read(p); print(f"{crackle(y, sr):6.2f}  {hf_level(y, sr):6.1f} dB (6-12 kHz)  {p}")
