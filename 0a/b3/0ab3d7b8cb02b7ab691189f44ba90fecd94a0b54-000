# 25 October 2026 16:35: polish one recipe and judge it on held-out noise seeds (never seen by the fit).
# FR : polit une recette et la juge sur des graines de bruit jamais vues.
import sys, json, time, argparse; sys.path.insert(0, ".")
import numpy as np, soundfile as sf
from zrsfx.render import render
from zrsfx.polish import polish
from zrsfx.score import score
ap = argparse.ArgumentParser(); ap.add_argument("recipe"); ap.add_argument("ref")
ap.add_argument("--steps", type=int, default=150); ap.add_argument("--lr", type=float, default=0.3)
ap.add_argument("--out")
a = ap.parse_args()
r = json.load(open(a.recipe)); x, sr = sf.read(a.ref)
def judge(rr):
    s = [score(render(rr, sr, seed=k), x, sr) for k in (7, 8, 9)]
    return round(float(np.mean([v["invariant"] for v in s])), 2), round(float(np.mean([v["exact"] for v in s])), 2)
print("before held-out (inv, exact):", judge(r))
t = time.time(); p = polish(r, x, sr, steps=a.steps, lr=a.lr, log=print)
print("after  held-out (inv, exact):", judge(p), f"{time.time()-t:.0f}s")
if a.out: json.dump(p, open(a.out, "w"))
