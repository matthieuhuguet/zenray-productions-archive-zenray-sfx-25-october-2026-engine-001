# 25 October 2026 22:30: ZenRay SFX local app server (http://127.0.0.1:3120). Serves app/index.html, the fonts, the
# WAVs of the project, and a small JSON API: library, render (brief text or recipe, with macros), describe (text ->
# three proposals), reproduce (reference WAV -> recipe + brief). No AI anywhere. FR : serveur local de l'app.
import base64, io, json, sys, threading, time, traceback
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from pathlib import Path
from urllib.parse import urlparse, parse_qs

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
import numpy as np, soundfile as sf
from zrsfx import brief as B, compose as C, recipetext as RT, semantic as SM
from zrsfx.score import score

CONFIG = {"port": 3120, "recipesRun": "out/repro-03", "briefsRun": "out/brief-05", "cleanRun": "out/clean-02",
          "fonts": "/Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts", "sr": 48000}
LOCK = threading.Lock()


def wav_b64(y, sr):
    buf = io.BytesIO(); sf.write(buf, np.asarray(y, np.float32), sr, format="WAV", subtype="FLOAT"); return base64.b64encode(buf.getvalue()).decode()


def spectrogram_b64(y, sr, seconds=None):
    import librosa
    from PIL import Image
    M = librosa.power_to_db(librosa.feature.melspectrogram(y=np.asarray(y, np.float32), sr=sr, n_fft=2048, hop_length=128, n_mels=160), ref=1.0)
    a = np.clip((M + 90) / 90, 0, 1)[::-1]
    img = Image.fromarray((np.stack([a ** 0.6, a ** 1.5, a ** 3], -1) * 255).astype(np.uint8)).resize((900, 220))
    buf = io.BytesIO(); img.save(buf, "PNG"); return base64.b64encode(buf.getvalue()).decode()


def library():
    out = []
    res = {}
    for key, run in (("recipe", CONFIG["recipesRun"]), ("brief", CONFIG["briefsRun"]), ("clean", CONFIG["cleanRun"])):
        p = ROOT / run / "results.json"
        if p.exists():
            for r in json.load(open(p)):
                res.setdefault(r["ref"], {})[key] = r
    for ref in sorted((ROOT / "refs").glob("*.wav")):
        n = ref.stem
        item = {"name": n, "ref": f"refs/{n}.wav", "scores": res.get(n, {})}
        rp = ROOT / CONFIG["recipesRun"] / f"{n}.recipe.json"
        bp = ROOT / CONFIG["briefsRun"] / f"{n}.brief.txt"
        item["hasRecipe"] = rp.exists()
        item["brief"] = bp.read_text() if bp.exists() else ""
        for k in ("dirty", "cleaned", "repro"):
            f = ROOT / CONFIG["cleanRun"] / f"{n}.{k}.wav"
            if f.exists():
                item[k] = str(f.relative_to(ROOT))
        out.append(item)
    return {"items": out, "macros": json.loads((ROOT / "params/macros.json").read_text()),
            "archetypes": [k for k in json.loads((ROOT / "params/archetypes.json").read_text()) if not k.startswith("_")]}


def render_payload(body):
    sr = CONFIG["sr"]
    macros = body.get("macros", {})
    if body.get("kind") == "recipetext":
        obj = C.apply_macros_recipe(RT.from_text(body["text"]), macros)
    elif body.get("kind") == "recipe":
        r = json.load(open(ROOT / CONFIG["recipesRun"] / f"{body['name']}.recipe.json"))
        obj = C.apply_macros_recipe(r, macros)
    else:
        obj = C.apply_macros(B.from_text(body["text"]), macros)
    y = C.render_any(obj, sr)
    out = {"wav": wav_b64(y, sr), "png": spectrogram_b64(y, sr), "seconds": round(len(y) / sr, 3)}
    if body.get("compare") and not any(macros.get(k) for k in ("pitch", "weight", "bright", "space", "gain")) and macros.get("time", 1) == 1:
        x, _ = sf.read(ROOT / "refs" / f"{body['compare']}.wav")
        s = score(y[:len(x)], x, sr)
        out["score"] = {k: s[k] for k in ("invariant", "exact", "linesW", "excessPct", "floorDb")}
    return out


def describe_payload(body):
    br = C.describe_to_brief(body["text"], body.get("name", "sfx"))
    base = B.to_text(br)
    props = []
    for p in C.proposals(br):
        y = C.render_any(p["brief"], CONFIG["sr"])
        props.append({"name": p["name"], "macros": p["macros"], "wav": wav_b64(y, CONFIG["sr"]), "png": spectrogram_b64(y, CONFIG["sr"])})
    return {"text": base, "proposals": props, "sources": sorted({e.get("source", "") for e in br["events"]})}


# 26 October 2026: semantic editing endpoints. Models are cached per sound (the decomposition takes a few seconds).
MODELS = {}
HUES = [(232, 120, 80), (90, 160, 230), (120, 200, 120), (230, 190, 70), (190, 120, 220), (90, 210, 200), (240, 130, 170), (170, 170, 170)]


def model_for(name):
    if name not in MODELS:
        r = json.load(open(ROOT / CONFIG["recipesRun"] / f"{Path(name).name}.recipe.json"))
        MODELS[name] = SM.build(r, CONFIG["sr"])
    return MODELS[name]


def component_map_b64(m):
    """Colour map of the components: each time-frequency cell takes the colour of the component that owns most of
    its energy, its brightness the total level (mel scale, same frame as the spectrograms)."""
    import librosa
    from PIL import Image
    sr = m["sr"]
    mel = librosa.filters.mel(sr=sr, n_fft=2048, n_mels=160)
    maps = []
    for c in m["components"]:
        y = SM.solo(m, c["index"], seed=7)
        X = np.abs(np.asarray(librosa.stft(y.astype(np.float32), n_fft=2048, hop_length=128))) ** 2
        maps.append(mel @ X)
    n = min(x.shape[1] for x in maps); maps = np.stack([x[:, :n] for x in maps])
    tot = maps.sum(0); db = 10 * np.log10(tot + 1e-20); v = np.clip((db - (db.max() - 90)) / 90, 0, 1)
    own = maps.argmax(0)
    rgb = np.zeros(own.shape + (3,))
    for i in range(len(maps)):
        rgb[own == i] = HUES[i % len(HUES)]
    img = (rgb * v[..., None] ** 0.6)[::-1].astype(np.uint8)
    buf = io.BytesIO(); Image.fromarray(img).resize((900, 220)).save(buf, "PNG"); return base64.b64encode(buf.getvalue()).decode()


def semantic_info(name):
    m = model_for(name)
    comps = SM.summary(m)
    for c, h in zip(comps, HUES):
        c["colour"] = "#%02x%02x%02x" % HUES[c["index"] % len(HUES)]
    return {"name": name, "components": comps, "sliders": SM.cfg()["sliders"], "map": component_map_b64(m),
            "versions": sorted(p.name for p in (ROOT / "out/semantic" / name).glob("V_*.json")) if (ROOT / "out/semantic" / name).exists() else []}


def semantic_render(body):
    m = model_for(body["name"])
    edits = body.get("edits", {})
    y = SM.solo(m, int(body["solo"]), edits, seed=7) if body.get("solo") is not None else SM.render(m, edits, seed=7)
    peak = np.abs(y).max()
    y = y / peak * 10 ** (-1 / 20) if peak > 10 ** (-1 / 20) else y
    out = {"wav": wav_b64(y, CONFIG["sr"]), "png": spectrogram_b64(y, CONFIG["sr"]), "seconds": round(len(y) / CONFIG["sr"], 3)}
    if body.get("solo") is None and body.get("measure", True):
        out["distance"] = SM.edit_distance(m, edits)
    return out


def semantic_save(body):
    name = Path(body["name"]).name
    d = ROOT / "out/semantic" / name; d.mkdir(parents=True, exist_ok=True)
    k = 1 + max([int(p.stem[2:]) for p in d.glob("V_*.json")] or [0])
    v = d / f"V_{k:03d}.json"
    m = model_for(name)
    rec = {"sound": name, "recipe": str(Path(CONFIG["recipesRun"]) / f"{name}.recipe.json"), "edits": body.get("edits", {}),
           "components": [c["name"] for c in m["components"]], "distance": SM.edit_distance(m, body.get("edits", {})),
           "date": time.strftime("%d %B %Y %H:%M")}
    v.write_text(json.dumps(rec, indent=1, ensure_ascii=False))
    sf.write(d / f"V_{k:03d}.wav", np.asarray(SM.render(m, body.get("edits", {}), seed=7), np.float32), CONFIG["sr"])
    return {"version": v.name, "path": str(v)}


def semantic_load(name, version):
    v = ROOT / "out/semantic" / Path(name).name / Path(version).name
    return json.loads(v.read_text())


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, data, ctype="application/json"):
        b = data if isinstance(data, bytes) else json.dumps(data).encode()
        self.send_response(code); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(b)

    def do_GET(self):
        u = urlparse(self.path)
        if u.path in ("/", "/index.html"):
            return self._send(200, (ROOT / "app/index.html").read_bytes(), "text/html; charset=utf-8")
        if u.path.startswith("/listen/"):  # the listening proof pages of out/<run>/listen.html
            f = (ROOT / "out" / Path(u.path).parts[2] / "listen.html").resolve()
            return self._send(200, f.read_bytes(), "text/html; charset=utf-8") if ROOT in f.parents and f.exists() else self._send(404, {"error": "listen"})
        if u.path.startswith("/fonts/"):
            f = Path(CONFIG["fonts"]) / Path(u.path).name
            return self._send(200, f.read_bytes(), "font/woff2") if f.exists() else self._send(404, {"error": "font"})
        if u.path == "/api/library":
            return self._send(200, library())
        if u.path == "/api/semantic":
            q = parse_qs(u.query)
            with LOCK:
                if "version" in q:
                    return self._send(200, semantic_load(q["name"][0], q["version"][0]))
                return self._send(200, semantic_info(Path(q["name"][0]).name))
        if u.path == "/api/longtext":
            n = Path(parse_qs(u.query)["name"][0]).name
            r = json.load(open(ROOT / CONFIG["recipesRun"] / f"{n}.recipe.json"))
            return self._send(200, {"text": RT.to_text(r)})
        if u.path == "/audio":
            f = (ROOT / parse_qs(u.query)["p"][0]).resolve()
            if ROOT not in f.parents or f.suffix != ".wav" or not f.exists():
                return self._send(404, {"error": "not found"})
            return self._send(200, f.read_bytes(), "audio/wav")
        if u.path == "/api/spectrogram":
            f = (ROOT / parse_qs(u.query)["p"][0]).resolve()
            if ROOT not in f.parents or not f.exists():
                return self._send(404, {"error": "not found"})
            y, sr = sf.read(f)
            return self._send(200, {"png": spectrogram_b64(y if y.ndim == 1 else y.mean(1), sr)})
        self._send(404, {"error": "unknown"})

    def do_POST(self):
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
            with LOCK:
                if self.path == "/api/render":
                    return self._send(200, render_payload(body))
                if self.path == "/api/semantic/render":
                    return self._send(200, semantic_render(body))
                if self.path == "/api/semantic/save":
                    return self._send(200, semantic_save(body))
                if self.path == "/api/describe":
                    return self._send(200, describe_payload(body))
            self._send(404, {"error": "unknown"})
        except Exception as e:  # the page shows the cause, never a silent failure
            traceback.print_exc()
            self._send(400, {"error": f"{type(e).__name__}: {e}"})


if __name__ == "__main__":
    s = ThreadingHTTPServer(("127.0.0.1", CONFIG["port"]), H)
    print(f"ZenRay SFX on http://127.0.0.1:{CONFIG['port']}", flush=True)
    s.serve_forever()
